// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "vim_mode == normal && !menu",
    "bindings": {
      // Helix-style space menu: pickers, LSP actions, diagnostics, and clipboard.
      "space shift-f": "workspace::Open",
      "space b": "tab_switcher::Toggle",
      "space j": "command_palette::Toggle",
      "space g": "git_panel::Toggle",
      "space shift-g": "debug_panel::Toggle",
      "space k": "editor::Hover",
      "space s": "outline::Toggle",
      "space shift-s": "project_symbols::Toggle",
      "space d": "diagnostics::DeployCurrentFile",
      "space shift-d": "diagnostics::Deploy",
      "space r": "editor::Rename",
      "space a": "editor::ToggleCodeActions",
      "space h": "editor::FindAllReferences",
      "space w": "workspace::ActivateNextPane",
      "space c": "editor::ToggleComments",
      "space shift-c": "editor::ToggleBlockComments",
      "space shift-p": "editor::Paste",
      "space y": "editor::Copy",
      "space shift-y": "editor::Copy",
      "space f": "file_finder::Toggle",
      "space e": "project_panel::Toggle",
      "space p": "projects::OpenRecent",
      "space /": "workspace::NewSearch",
      "space ?": "command_palette::Toggle",

      // Helix-style goto/LSP layer.
      "g d": "editor::GoToDefinition",
      "g y": "editor::GoToTypeDefinition",
      "g r": "editor::FindAllReferences",
      "g i": "editor::GoToImplementation",
      "g f": "editor::OpenSelectedFilename",
      "g a": "pane::AlternateFile",
      "g n": "pane::ActivateNextItem",
      "g p": "pane::ActivatePreviousItem",
      "g .": "pane::GoForward",
      // "g w": "vim::HelixJumpToWord",
      "shift-h": "pane::ActivatePreviousItem",
      "shift-l": "pane::ActivateNextItem",

      // Diagnostics and structural navigation.
      "] d": "editor::GoToDiagnostic",
      "[ d": "editor::GoToPreviousDiagnostic",
      "] g": "editor::GoToNextChange",
      "[ g": "editor::GoToPreviousChange",
      "] f": "editor::GoToNextSymbol",
      "[ f": "editor::GoToPreviousSymbol",
      "] c": "editor::GoToHunk",
      "[ c": "editor::GoToPreviousHunk",
      "] space": "editor::NewlineBelow",
      "[ space": "editor::NewlineAbove",

      // Editing and selection operations with close Zed equivalents.
      "=": "editor::FormatSelections",
      "`": "editor::ConvertToLowerCase",
      "alt-`": "editor::ConvertToUpperCase",
      "~": "editor::ToggleCase",
      ">": "vim::Indent",
      "<": "vim::Outdent",
      "%": "editor::SelectAll",

      // View/window commands.
      "z z": "editor::ScrollCursorCenter",
      "z c": "editor::ScrollCursorCenter",
      "z t": "editor::ScrollCursorTop",
      "z b": "editor::ScrollCursorBottom",
      "ctrl-w w": "workspace::ActivateNextPane",
      "ctrl-w ctrl-w": "workspace::ActivateNextPane",
      "ctrl-w v": "pane::SplitRight",
      "ctrl-w ctrl-v": "pane::SplitRight",
      "ctrl-w s": "pane::SplitDown",
      "ctrl-w ctrl-s": "pane::SplitDown",
      "ctrl-w h": "workspace::ActivatePaneLeft",
      "ctrl-w ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-w left": "workspace::ActivatePaneLeft",
      "ctrl-w j": "workspace::ActivatePaneDown",
      "ctrl-w ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-w down": "workspace::ActivatePaneDown",
      "ctrl-w k": "workspace::ActivatePaneUp",
      "ctrl-w ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-w up": "workspace::ActivatePaneUp",
      "ctrl-w l": "workspace::ActivatePaneRight",
      "ctrl-w ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-w right": "workspace::ActivatePaneRight",
      "ctrl-w q": "pane::CloseActiveItem",
      "ctrl-w ctrl-q": "pane::CloseActiveItem",
      "ctrl-w o": "workspace::ToggleZoom",
      "ctrl-w ctrl-o": "workspace::ToggleZoom",
      "ctrl-w shift-h": "workspace::SwapPaneLeft",
      "ctrl-w shift-j": "workspace::SwapPaneDown",
      "ctrl-w shift-k": "workspace::SwapPaneUp",
      "ctrl-w shift-l": "workspace::SwapPaneRight",
      "shift-q": "pane::CloseActiveItem",
    },
  },
  {
    "context": "vim_mode == insert && !menu",
    "bindings": {
      "j k": "vim::NormalBefore",
    },
  },
  {
    "context": "Dock",
    "bindings": {
      "ctrl-w h": "workspace::ActivatePaneLeft",
      "ctrl-w j": "workspace::ActivatePaneDown",
      "ctrl-w k": "workspace::ActivatePaneUp",
      "ctrl-w l": "workspace::ActivatePaneRight",
    },
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "space e": "project_panel::Toggle",
    },
  },
  {
    "context": "GitPanel",
    "bindings": {
      "space g": "git_panel::Toggle",
    },
  },
  {
    "context": "EmptyPane || SharedScreen",
    "bindings": {
      "space f": "file_finder::Toggle",
      "space e": "project_panel::Toggle",
      "space p": "projects::OpenRecent",
      "space g": "git_panel::Toggle",
    },
  },
]
